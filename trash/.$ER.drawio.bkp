        <mxCell id="6z0KkPJDIArgJpmvSsoJ-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;BERBA&lt;/h1&gt;&lt;div&gt;radi se harvest event, cilj je ubrati red zasadenih biljaka, dakle svaki red ima svoj planting_row_id&amp;nbsp;&lt;/div&gt;&lt;div&gt;c&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="1">
